# Freight Rail Data Pipeline Configuration
#
# Copy this file to .env and fill in your values.
# Most sources work without credentials for public data.

# USDA Socrata App Token (optional, increases rate limits)
# Sign up free at https://data.gov/signup
USDA_SOCRATA_APP_TOKEN=

# Pipeline behavior
FREIGHT_PIPELINE_OUTPUT_DIR=data
FREIGHT_PIPELINE_LOG_DIR=logs
FREIGHT_PIPELINE_LOG_LEVEL=INFO
FREIGHT_PIPELINE_LOG_JSON=false
FREIGHT_PIPELINE_OUTPUT_FORMAT=parquet
FREIGHT_PIPELINE_MAX_RETRIES=3
FREIGHT_PIPELINE_REQUEST_TIMEOUT=30
